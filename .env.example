# Copy to .env for local development. Never commit real values.

# --- Shared app: database and Better Auth (Admin & Identity) ---
# Local PostgreSQL only; use separate credentials outside development.
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop"
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Search & Recommendations ---
# Optional. Where the MCP server and playground reach our API. Defaults to
# http://127.0.0.1:3000 locally and to the deployment's own URL on Vercel.
SEARCH_API_BASE_URL=""

# --- Search playground (/docs/search-recommendations/playground) ---
# Off until a model and approved users are configured.
PLAYGROUND_ENABLED="false"
# Comma-separated Better Auth user IDs allowed to run the playground.
PLAYGROUND_USER_IDS=""
# Models the playground may use. Replace the model id with one Chat AI offers.
PLAYGROUND_MODELS_JSON='[{"id":"academic-cloud","label":"Academic Cloud","model":"REPLACE_WITH_AVAILABLE_MODEL","maxOutputTokens":4096,"temperature":false,"topP":false,"toolChoice":false}]'

# --- Chat AI (Academic Cloud), used by the playground and agent.py ---
CHAT_AI_API_KEY=""
CHAT_AI_BASE_URL="https://chat-ai.academiccloud.de/v1"
CHAT_AI_MODEL=""
