# Local PostgreSQL only; use separate credentials outside development.
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop"
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Search MCP: explicit origin, never derived from an incoming Host header.
SEARCH_API_BASE_URL="http://127.0.0.1:3000"
SEARCH_MCP_URL="http://127.0.0.1:3000/api/mcp/search-recommendations"
# Set only after verifying a stable public deployment.
SEARCH_PUBLIC_MCP_URL=""
# Fail closed until a real database, approved user IDs and model are configured.
PLAYGROUND_ENABLED="false"
PLAYGROUND_USER_IDS=""
# Example only: replace model id and confirm capabilities before enabling.
PLAYGROUND_MODELS_JSON='[{"id":"academic-cloud","label":"Academic Cloud (configure first)","model":"REPLACE_WITH_AVAILABLE_MODEL","maxOutputTokens":4096,"temperature":false,"topP":false,"toolChoice":false}]'
CHAT_AI_API_KEY=""
CHAT_AI_BASE_URL=""
CHAT_AI_MODEL=""
# Optional preview protection bypass, server-side only; never put in public docs.
VERCEL_AUTOMATION_BYPASS_SECRET=""
