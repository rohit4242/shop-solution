# Copy to .env for local development. Never commit real values.

# --- Shared app: database and Better Auth (Admin & Identity) ---
# Local PostgreSQL only; use separate credentials outside development.
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop"
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Search & Recommendations ---
# Optional. Where the MCP server and playground reach our API. Defaults to
# http://127.0.0.1:3000 locally and to the deployment's own URL on Vercel.
SEARCH_API_BASE_URL=""

# --- Search playground (/docs/search-recommendations/playground) ---
# Off until a model and an access code are configured.
PLAYGROUND_ENABLED="false"
# Shared team code that unlocks the playground. Pick a long random value.
PLAYGROUND_ACCESS_CODE=""
# Models the playground may use. Use model ids your provider offers.
PLAYGROUND_MODELS_JSON='[{"id":"default","label":"GPT-4.1 mini","model":"gpt-4.1-mini","maxOutputTokens":4096,"temperature":true,"topP":true,"toolChoice":true}]'

# --- Model provider, used by the playground and agent.py ---
# Any OpenAI-compatible API. Leave OPENAI_BASE_URL empty for OpenAI, or set e.g.
# https://openrouter.ai/api/v1, https://api.groq.com/openai/v1,
# https://generativelanguage.googleapis.com/v1beta/openai/ or http://localhost:11434/v1 (Ollama).
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
# Model for agent.py, e.g. gpt-4.1-mini. Pick one that supports tool calling.
OPENAI_MODEL=""
